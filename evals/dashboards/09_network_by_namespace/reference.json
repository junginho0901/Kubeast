{
  "apiVersion": "kubeast.io/dashboards/v1alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "network-by-namespace",
    "title": "네임스페이스별 네트워크",
    "scope": {
      "cluster": "*"
    }
  },
  "spec": {
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "panels": {
      "rx": {
        "title": "수신",
        "kind": "timeseries",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum by (namespace) (rate(container_network_receive_bytes_total[$__rate_interval]))",
            "legend": "{{namespace}}"
          }
        ],
        "fieldDefaults": {
          "unit": "Bps"
        }
      },
      "tx": {
        "title": "송신",
        "kind": "timeseries",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum by (namespace) (rate(container_network_transmit_bytes_total[$__rate_interval]))",
            "legend": "{{namespace}}"
          }
        ],
        "fieldDefaults": {
          "unit": "Bps"
        }
      }
    },
    "layout": {
      "items": [
        {
          "panel": "rx",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        {
          "panel": "tx",
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        }
      ]
    }
  }
}
