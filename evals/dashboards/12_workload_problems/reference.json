{
  "apiVersion": "kubeast.io/dashboards/v1alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "workload-problems",
    "title": "워크로드 문제",
    "scope": {
      "cluster": "*"
    }
  },
  "spec": {
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "panels": {
      "restarts": {
        "title": "최근 1시간 재시작 많은 파드",
        "kind": "table",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "topk(10, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])) > 0)"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "unavailable": {
        "title": "준비 안 된 레플리카가 있는 디플로이먼트",
        "kind": "table",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum by (namespace, deployment) (kube_deployment_status_replicas_unavailable)"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "pending": {
        "title": "Pending 파드",
        "kind": "stat",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "waiting": {
        "title": "대기 중인 컨테이너 (이유별)",
        "kind": "table",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum by (namespace, pod, reason) (kube_pod_container_status_waiting_reason)"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      }
    },
    "layout": {
      "items": [
        {
          "panel": "restarts",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        {
          "panel": "unavailable",
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        {
          "panel": "pending",
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        {
          "panel": "waiting",
          "x": 6,
          "y": 8,
          "w": 18,
          "h": 8
        }
      ]
    }
  }
}
