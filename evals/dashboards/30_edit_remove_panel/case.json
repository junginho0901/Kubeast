{
  "question": "네트워크 패널은 빼 줘",
  "cluster": "default",
  "panels": {
    "min": 3,
    "max": 3
  },
  "expect": [
    {
      "what": "노드 CPU",
      "metrics": [
        "node_cpu_seconds_total"
      ],
      "functions": [
        "rate",
        "irate"
      ]
    },
    {
      "what": "노드 메모리",
      "metrics": [
        "node_memory_MemAvailable_bytes",
        "node_memory_MemFree_bytes"
      ]
    },
    {
      "what": "노드 디스크",
      "metrics": [
        "node_filesystem_avail_bytes",
        "node_filesystem_free_bytes",
        "node_filesystem_size_bytes"
      ]
    }
  ],
  "kind": "edit",
  "keep": [
    "cpu-busy",
    "mem-used",
    "disk-used"
  ],
  "forbid": [
    "node_network_"
  ]
}
