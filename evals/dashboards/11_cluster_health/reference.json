{
  "apiVersion": "kubeast.io/dashboards/v1alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "cluster-health",
    "title": "클러스터 상태",
    "scope": {
      "cluster": "*"
    }
  },
  "spec": {
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "panels": {
      "nodes-not-ready": {
        "title": "준비 안 된 노드",
        "kind": "stat",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum(kube_node_status_condition{condition=\"Ready\", status!=\"true\"})"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "pods-by-phase": {
        "title": "상태별 파드",
        "kind": "piechart",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum by (phase) (kube_pod_status_phase)",
            "legend": "{{phase}}"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "restarts": {
        "title": "최근 1시간 재시작",
        "kind": "stat",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum(increase(kube_pod_container_status_restarts_total[1h]))"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "unavailable": {
        "title": "준비 안 된 레플리카",
        "kind": "stat",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum(kube_deployment_status_replicas_unavailable)"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "cpu": {
        "title": "노드 CPU 사용률",
        "kind": "timeseries",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
            "legend": "{{instance}}"
          }
        ],
        "fieldDefaults": {
          "unit": "percentunit"
        }
      },
      "mem": {
        "title": "노드 메모리 사용률",
        "kind": "timeseries",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
            "legend": "{{instance}}"
          }
        ],
        "fieldDefaults": {
          "unit": "percentunit"
        }
      }
    },
    "layout": {
      "items": [
        {
          "panel": "nodes-not-ready",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "panel": "pods-by-phase",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 8
        },
        {
          "panel": "restarts",
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "panel": "unavailable",
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "panel": "cpu",
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        {
          "panel": "mem",
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        }
      ]
    }
  }
}
