{
  "apiVersion": "kubeast.io/dashboards/v1alpha1",
  "kind": "Dashboard",
  "metadata": {
    "name": "node-conditions",
    "title": "노드 상태 조건",
    "scope": {
      "cluster": "*"
    }
  },
  "spec": {
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "panels": {
      "not-ready": {
        "title": "준비 안 된 노드",
        "kind": "stat",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"false\"})"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      },
      "conditions": {
        "title": "켜진 조건",
        "kind": "table",
        "queries": [
          {
            "refId": "A",
            "store": "prometheus",
            "expr": "kube_node_status_condition{status=\"true\"} == 1"
          }
        ],
        "fieldDefaults": {
          "unit": "short"
        }
      }
    },
    "layout": {
      "items": [
        {
          "panel": "not-ready",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "panel": "conditions",
          "x": 6,
          "y": 0,
          "w": 18,
          "h": 8
        }
      ]
    }
  }
}
