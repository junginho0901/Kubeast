{
  "id": 42,
  "uid": "web-red-01",
  "title": "Web — RED",
  "description": "Hand-written fixture covering the cases the importer must handle.",
  "tags": ["web", "red"],
  "timezone": "",
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "5s",
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "30s", "1m"]},
  "templating": {
    "list": [
      {"name": "ds", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "prom"}, "hide": 0, "skipUrlSync": false},
      {"name": "cluster", "type": "query", "datasource": {"type": "prometheus", "uid": "${ds}"}, "query": {"query": "label_values(up, cluster)", "refId": "PrometheusVariableQueryEditor-VariableQuery"}, "definition": "label_values(up, cluster)", "refresh": 1},
      {"name": "namespace", "label": "Namespace", "type": "query", "datasource": {"type": "prometheus", "uid": "${ds}"}, "query": "label_values(kube_pod_info{cluster=\"$cluster\"}, namespace)", "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "sort": 1, "regex": "/^web-.*/"},
      {"name": "env", "type": "custom", "query": "prod,staging", "options": []},
      {"name": "interval", "type": "interval", "query": "1m,5m,10m", "auto": true, "auto_count": 30, "auto_min": "10s"},
      {"name": "filter", "type": "textbox", "query": "error"},
      {"name": "Filters", "type": "adhoc", "datasource": {"type": "prometheus", "uid": "${ds}"}}
    ]
  },
  "annotations": {
    "list": [
      {"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"},
      {"name": "Deploys", "datasource": {"type": "prometheus", "uid": "${ds}"}, "enable": true, "iconColor": "#5794F2", "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"$namespace\"}[2m]) > 0", "step": "60s", "titleFormat": "deploy"}
    ]
  },
  "links": [
    {"title": "Runbook", "url": "https://runbooks.example.com/web", "targetBlank": true, "type": "link", "icon": "doc"},
    {"title": "Related", "type": "dashboards", "tags": ["web"], "asDropdown": true}
  ],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${ds}"},
      "targets": [
        {"refId": "A", "expr": "sum by (code) (rate(http_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "{{code}}", "editorMode": "code", "range": true},
        {"refId": "B", "expr": "sum(rate(http_requests_total[$__rate_interval]))", "legendFormat": "total", "hide": true}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0, "decimals": 1,
          "color": {"mode": "fixed", "fixedColor": "semi-dark-green"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 80}]},
          "custom": {"lineWidth": 1, "fillOpacity": 10}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "5xx"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]},
          {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash"}}]},
          {"matcher": {"id": "byNames", "options": {"mode": "exclude", "names": ["2xx"]}}, "properties": []}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "transformations": [
        {"id": "organize", "options": {"renameByName": {"Value": "rps"}}},
        {"id": "spatial", "options": {}, "disabled": true}
      ],
      "pluginVersion": "13.0.1"
    },
    {
      "id": 2, "type": "singlestat", "title": "Error ratio",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": "${ds}",
      "targets": [{"refId": "A", "expr": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))"}],
      "valueName": "current", "format": "percentunit", "colorBackground": true
    },
    {
      "id": 3, "type": "graph", "title": "Latency p99",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "interval": "30s"}],
      "lines": true, "linewidth": 2, "yaxes": [{"format": "s"}, {"format": "short"}]
    },
    {
      "id": 9, "type": "grafana-clock-panel", "title": "Clock",
      "gridPos": {"x": 12, "y": 4, "w": 4, "h": 4},
      "options": {"mode": "time"}
    },
    {
      "id": 10, "type": "table", "title": "Slow requests (Elasticsearch)",
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 4},
      "datasource": {"type": "elasticsearch", "uid": "es-logs"},
      "targets": [{"refId": "A", "query": "duration_ms:>1000", "metrics": [{"type": "count", "id": "1"}], "bucketAggs": []}]
    },
    {
      "id": 11, "type": "text", "title": "Notes",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 3},
      "options": {"mode": "markdown", "content": "Runbook: see the link above."}
    },
    {
      "id": 12, "title": "Shared CPU panel",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 3},
      "libraryPanel": {"uid": "lib-cpu", "name": "CPU by pod"}
    },
    {
      "id": 4, "type": "row", "title": "Pods", "collapsed": false,
      "gridPos": {"x": 0, "y": 11, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 5, "type": "table", "title": "Error logs by pod",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 6},
      "datasource": "Loki",
      "targets": [{"refId": "A", "expr": "sum by (pod) (count_over_time({namespace=~\"$namespace\"} |= \"error\" [5m]))", "queryType": "range"}]
    },
    {
      "id": 6, "type": "row", "title": "Details", "collapsed": true,
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1},
      "panels": [
        {
          "id": 7, "type": "logs", "title": "Logs",
          "gridPos": {"x": 0, "y": 19, "w": 16, "h": 8},
          "datasource": {"type": "loki", "uid": "loki"},
          "targets": [{"refId": "A", "expr": "{namespace=~\"$namespace\"} |= \"$filter\""}],
          "options": {"showTime": true, "wrapLogMessage": true}
        },
        {
          "id": 8, "type": "gauge", "title": "Memory used",
          "gridPos": {"x": 16, "y": 19, "w": 8, "h": 8},
          "targets": [{"refId": "A", "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\"}) / sum(kube_pod_container_resource_limits{resource=\"memory\", namespace=~\"$namespace\"})", "instant": true}],
          "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "thresholds": {"mode": "percentage", "steps": [{"color": "#73BF69", "value": null}, {"color": "#FF9830", "value": 70}, {"color": "#F2495C", "value": 90}]}}, "overrides": []},
          "repeat": "namespace", "repeatDirection": "h", "maxPerRow": 3
        }
      ]
    }
  ]
}
