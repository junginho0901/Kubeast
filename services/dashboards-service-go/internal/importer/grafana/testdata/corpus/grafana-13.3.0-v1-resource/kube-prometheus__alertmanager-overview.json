        "id": 4,
        "panels": [],
        "title": "Notifications",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "rate of successful and invalid notifications sent by the Alertmanager",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 10,
              "showPoints": "never",
              "stacking": {
                "mode": "normal"
              }
