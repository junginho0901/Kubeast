        "title": "Alerts",
        "type": "row"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "current set of alerts stored in the Alertmanager",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 10,
              "showPoints": "never",
              "stacking": {
                "mode": "normal"
              }
            },
            "unit": "none"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 12,
          "x": 0,
          "y": 1
        },
        "id": 2,
        "options": {
          "legend": {
            "showLegend": false
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "pluginVersion": "v13.0.0",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            },
            "expr": "sum(alertmanager_alerts{namespace=~\"$namespace\",service=~\"$service\"}) by (namespace,service,instance)",
            "intervalFactor": 2,
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "title": "Alerts",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "description": "rate of successful and invalid alerts received by the Alertmanager",
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 10,
              "showPoints": "never",
              "stacking": {
                "mode": "normal"
              }
            },
            "unit": "ops"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 7,
          "w": 12,
          "x": 12,
          "y": 1
        },
        "id": 3,
        "options": {
          "legend": {
            "showLegend": false
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "pluginVersion": "v13.0.0",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            },
            "expr": "sum(rate(alertmanager_alerts_received_total{namespace=~\"$namespace\",service=~\"$service\"}[$__rate_interval])) by (namespace,service,instance)",
            "intervalFactor": 2,
            "legendFormat": "{{instance}} Received",
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "$datasource"
            },
            "expr": "sum(rate(alertmanager_alerts_invalid_total{namespace=~\"$namespace\",service=~\"$service\"}[$__rate_interval])) by (namespace,service,instance)",
            "intervalFactor": 2,
            "legendFormat": "{{instance}} Invalid",
            "refId": "B"
          }
        ],
        "title": "Alerts receive rate",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 8
