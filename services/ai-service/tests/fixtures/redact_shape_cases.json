    {
      "name": "a glued name holding a block",
      "input": "PGPASSWORD: |\n  fake-block-value\nname: app\n",
      "want": "PGPASSWORD: |\n  <REDACTED:PGPASSWORD>\nname: app\n"
    },
    {
      "name": "digits under a glued name that holds the value itself",
      "input": "PGPASSWORD: 1234\nAPIKEY: 123456\nPGPASSWORD=1234\nAPIKEY=123456\nCLIENTSECRET: 1234\n",
