      "want": "PGPASSWORD: <REDACTED:PGPASSWORD>\nPGPASSWORD = <REDACTED:PGPASSWORD>\nPGPASSWORD=<REDACTED:PGPASSWORD>\nPGPASSWORD=<REDACTED:PGPASSWORD>\n"
