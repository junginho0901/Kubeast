{
  "text": [
    {
      "name": "a credential held in a block",
      "input": "token: |\n  fake-block-value\n  fake-second-line\nname: app\n",
      "want": "token: |\n  <REDACTED:token>\nname: app\n"
    },
    {
      "name": "a folded block",
      "input": "password: >-\n  fake-block-value\nreplicas: 3\n",
      "want": "password: >-\n  <REDACTED:password>\nreplicas: 3\n"
    },
    {
      "name": "a block inside a mapping keeps the keys after it",
      "input": "auth:\n  client_secret: |-\n    fake-block-value\n  user: bob\nport: 80\n",
      "want": "auth:\n  client_secret: |-\n    <REDACTED:client_secret>\n  user: bob\nport: 80\n"
    },
    {
      "name": "a block in a list item keeps the item's other keys",
      "input": "- password: |\n    fake-block-value\n  name: db\n- name: web\n",
      "want": "- password: |\n    <REDACTED:password>\n  name: db\n- name: web\n"
    },
    {
      "name": "a quoted key",
      "input": "\"token\": |\n  fake-block-value\nname: app",
      "want": "\"token\": |\n  <REDACTED:token>\nname: app"
    },
    {
      "name": "a blank line inside the block",
      "input": "token: |\n  fake-block-value\n\n  fake-second-line\n\nname: app\n",
      "want": "token: |\n  <REDACTED:token>\n\nname: app\n"
    },
    {
      "name": "a block that ends the text",
      "input": "token: |\n  fake-block-value",
      "want": "token: |\n  <REDACTED:token>"
    },
    {
      "name": "line ends with a carriage return",
      "input": "token: |\r\n  fake-block-value\r\nname: app\r\n",
      "want": "token: |\r\n  <REDACTED:token>\r\nname: app\r\n"
    },
    {
      "name": "an indentation indicator",
      "input": "token: |2\n    fake-block-value\nname: x\n",
      "want": "token: <REDACTED:token>\n    <REDACTED:token>\nname: x\n"
    },
    {
      "name": "a comment after the indicator",
      "input": "token: | # rotated\n  fake-block-value\nname: app\n",
      "want": "token: <REDACTED:token>\n  <REDACTED:token>\nname: app\n"
    },
    {
      "name": "a block under an ordinary key stays",
      "input": "description: |\n  free text\n  more text\nname: app\n",
      "want": "description: |\n  free text\n  more text\nname: app\n"
    },
    {
      "name": "a block under a key that names a credential but holds none stays",
      "input": "secretName: |\n  my-tls\ntoken_ttl: |\n  60\n",
      "want": "secretName: |\n  my-tls\ntoken_ttl: |\n  60\n"
    },
    {
      "name": "an empty block takes nothing after it",
      "input": "token: |\nname: app\n",
      "want": "token: |\nname: app\n"
    },
    {
      "name": "digits as a password on a line",
      "input": "password: 1234\n",
      "want": "password: <REDACTED:password>\n"
    },
    {
      "name": "digits as a password in an env file",
      "input": "DB_PASSWORD=12345678\n",
      "want": "DB_PASSWORD=<REDACTED:DB_PASSWORD>\n"
    },
    {
      "name": "digits as a password in JSON text",
      "input": "log line {\"password\": \"1234\"} end",
      "want": "log line {\"password\": \"<REDACTED:password>\"} end"
    },
    {
      "name": "digits as a password in a YAML env entry",
      "input": "- name: DB_PASSWORD\n  value: \"1234\"\n",
      "want": "- name: DB_PASSWORD\n  value: \"<REDACTED:DB_PASSWORD>\"\n"
    },
    {
      "name": "settings and counts on lines stay",
      "input": "password_min_length: 12\npassword_expiry_days: 90\npassword_retries: 3\ntoken: 5\nsecret: 3\ntoken_ttl: 60\nsession_timeout: 30m\nmax_tokens: 4096\n",
      "want": "password_min_length: 12\npassword_expiry_days: 90\npassword_retries: 3\ntoken: 5\nsecret: 3\ntoken_ttl: 60\nsession_timeout: 30m\nmax_tokens: 4096\n"
    },
    {
      "name": "words that are not a password stay",
      "input": "password: true\npwd: none\napi_key: auto\n",
      "want": "password: true\npwd: none\napi_key: auto\n"
    },
    {
      "name": "a password in the middle of a sentence",
      "input": "connecting to db with password=fake-pass-1 now\n",
      "want": "connecting to db with password=<REDACTED:password> now\n"
    },
    {
      "name": "a password between other pairs of a log line",
      "input": "level=info user=bob password=fake-pass-1 host=db\n",
      "want": "level=info user=bob password=<REDACTED:password> host=db\n"
    },
    {
      "name": "a token and an API key in one line",
      "input": "GET /x token=fake-token-1 api_key=fake-key-1 ok\n",
      "want": "GET /x token=<REDACTED:token> api_key=<REDACTED:api_key> ok\n"
    },
    {
      "name": "a token in a URL query keeps the rest of the URL",
      "input": "GET https://example.test/cb?token=fake-token-1&page=2 200\n",
      "want": "GET https://example.test/cb?token=<REDACTED:token>&page=2 200\n"
    },
    {
      "name": "a quoted value with spaces",
      "input": "msg=\"connect\" password=\"fake pass 1\" port=5432\n",
      "want": "msg=\"connect\" password=\"<REDACTED:password>\" port=5432\n"
    },
    {
      "name": "a command line's flags",
      "input": "mysql --password=fake-pass-1 --host=db\nkubectl create secret generic db --from-literal=password=fake-pass-1 --namespace=shop\n",
      "want": "mysql --password=<REDACTED:password> --host=db\nkubectl create secret generic db --from-literal=password=<REDACTED:password> --namespace=shop\n"
    },
    {
      "name": "a variable set in front of a command",
      "input": "PGPASSWORD=fake-pass-1 psql -h db\n",
      "want": "PGPASSWORD=<REDACTED:PGPASSWORD> psql -h db\n"
    },
    {
      "name": "a connection string's parts",
      "input": "Server=db;User=bob;Password=fake-pass-1;Database=shop\n",
      "want": "Server=db;User=bob;Password=<REDACTED:Password>;Database=shop\n"
    },
    {
      "name": "a dsn in a log line",
      "input": "dial dsn=postgres://bob:fake-pass-1@db/shop retry=3\n",
      "want": "dial dsn=<REDACTED:dsn> retry=3\n"
    },
    {
      "name": "a printed mapping with single quotes",
      "input": "{'user': 'bob', 'password': 'fake-pass-1'}\n",
      "want": "{'user': 'bob', 'password': '<REDACTED:password>'}\n"
    },
    {
      "name": "a quoted value after a colon in a sentence",
      "input": "auth failed user: bob password: \"fake-pass-1\"\n",
      "want": "auth failed user: bob password: \"<REDACTED:password>\"\n"
    },
    {
      "name": "a secret that does not read as an object's name",
      "input": "client_id=a secret=abc123 client_secret=my-value\n",
      "want": "client_id=a secret=<REDACTED:secret> client_secret=<REDACTED:client_secret>\n"
    },
    {
      "name": "an environment variable holds the value itself, name-shaped or not",
      "input": "env JWT_SECRET=my-dev-value HOME=/root\n",
      "want": "env JWT_SECRET=<REDACTED:JWT_SECRET> HOME=/root\n"
    },
    {
      "name": "settings named after a credential stay in a sentence",
      "input": "level=info password_policy=strict token_count=5 secret_name=my-tls token_ttl=60 password_min_length=12 max_tokens=4096 tokenizer=cl100k password_expiry_days=90\n",
      "want": "level=info password_policy=strict token_count=5 secret_name=my-tls token_ttl=60 password_min_length=12 max_tokens=4096 tokenizer=cl100k password_expiry_days=90\n"
    },
    {
      "name": "a policy on a line of its own stays",
      "input": "password_policy=strict\npassword_policy: strict\n",
      "want": "password_policy=strict\npassword_policy: strict\n"
    },
    {
      "name": "plain values of a URL query stay",
      "input": "GET https://example.test/search?q=password&page=2&sort=token&next=/home&password_policy=strict&token_count=5 200\n",
      "want": "GET https://example.test/search?q=password&page=2&sort=token&next=/home&password_policy=strict&token_count=5 200\n"
    },
    {
      "name": "the name of a Secret stays",
      "input": "reading secret=kube-system/my-tls secret=my-tls credentials=aws-creds secret=foo\n",
      "want": "reading secret=kube-system/my-tls secret=my-tls credentials=aws-creds secret=foo\n"
    },
    {
      "name": "a Secret's name in a metric's labels stays",
      "input": "kube_secret_info{namespace=\"shop\",secret=\"my-tls\"} 1\n",
      "want": "kube_secret_info{namespace=\"shop\",secret=\"my-tls\"} 1\n"
    },
    {
      "name": "counts and words that say nothing stay in a sentence",
      "input": "found token=5 secret=3 password=true password=none api_key=auto\n",
      "want": "found token=5 secret=3 password=true password=none api_key=auto\n"
    },
    {
      "name": "a state stays",
      "input": "auth failed token=expired password=missing\n",
      "want": "auth failed token=expired password=missing\n"
    },
    {
      "name": "sentences about a password stay",
      "input": "error: invalid password: too short\nthe token: expired\npassword must be set\nwrong password= given\n",
      "want": "error: invalid password: too short\nthe token: expired\npassword must be set\nwrong password= given\n"
    },
    {
      "name": "references to a value stay",
      "input": "using password=$DB_PASSWORD token=${TOKEN} password=%s password=<set> password=*** token={{ .token }}\n",
      "want": "using password=$DB_PASSWORD token=${TOKEN} password=%s password=<set> password=*** token={{ .token }}\n"
    },
    {
      "name": "comparisons stay",
      "input": "if password == other and token != other and password==other\n",
      "want": "if password == other and token != other and password==other\n"
    },
    {
      "name": "flags that name a file or an object stay",
      "input": "--token-auth-file=/etc/x --tls-private-key-file=/etc/y --service-account-key-file=/z --secret-name=foo --password-file=/p\n",
      "want": "--token-auth-file=/etc/x --tls-private-key-file=/etc/y --service-account-key-file=/z --secret-name=foo --password-file=/p\n"
    },
    {
      "name": "the working directory stays",
      "input": "env PWD=/app OLDPWD=/root HOME=/root\n",
      "want": "env PWD=/app OLDPWD=/root HOME=/root\n"
    },
    {
      "name": "flags and values of an API server's command line stay",
      "input": "kube-apiserver --use-service-account-credentials=true --enable-bootstrap-token-auth=true --oidc-username-claim=email --authorization-mode=Node,RBAC --controllers=*,bootstrapsigner,tokencleaner\n",
      "want": "kube-apiserver --use-service-account-credentials=true --enable-bootstrap-token-auth=true --oidc-username-claim=email --authorization-mode=Node,RBAC --controllers=*,bootstrapsigner,tokencleaner\n"
    },
    {
      "name": "an access log's plain query values stay and its token does not",
      "input": "GET /oauth/token?grant_type=password&client_id=web&refresh_token=fake-token-1 200\n",
      "want": "GET /oauth/token?grant_type=password&client_id=web&refresh_token=<REDACTED:refresh_token> 200\n"
    },
    {
      "name": "a value that already went through stays",
      "input": "user=bob password=<REDACTED:password>\n",
      "want": "user=bob password=<REDACTED:password>\n"
    },
    {
      "name": "a credential word as a value stays",
      "input": "reason=password msg=token\n",
      "want": "reason=password msg=token\n"
    }
  ],
  "objects": [
    {
      "name": "a container env entry",
      "input": {"name": "DB_PASSWORD", "value": "fake-password-1"},
      "want": {"name": "DB_PASSWORD", "value": "<REDACTED:DB_PASSWORD>"}
    },
    {
      "name": "a number in a container env entry",
      "input": {"name": "DB_PASSWORD", "value": 1234},
      "want": {"name": "DB_PASSWORD", "value": "<REDACTED:DB_PASSWORD>"}
    },
    {
      "name": "only the credential among a pod's env",
      "input": {
        "spec": {
          "containers": [
            {
              "name": "app",
              "env": [
                {"name": "API_TOKEN", "value": "fake-token-1"},
                {"name": "LOG_LEVEL", "value": "debug"},
                {"name": "DB_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "db", "key": "password"}}},
                {"name": "USE_SECRET", "value": "true"},
                {"name": "TOKEN_TTL", "value": "60"},
                {"name": "SECRET_NAME", "value": "my-secret"}
              ]
            }
          ]
        }
      },
      "want": {
        "spec": {
          "containers": [
            {
              "name": "app",
              "env": [
                {"name": "API_TOKEN", "value": "<REDACTED:API_TOKEN>"},
                {"name": "LOG_LEVEL", "value": "debug"},
                {"name": "DB_PASSWORD", "valueFrom": {"secretKeyRef": {"name": "db", "key": "password"}}},
                {"name": "USE_SECRET", "value": "true"},
                {"name": "TOKEN_TTL", "value": "60"},
                {"name": "SECRET_NAME", "value": "my-secret"}
              ]
            }
          ]
        }
      }
    },
    {
      "name": "numbers under a credential key",
      "input": {"password": 1234, "db_password": 5678, "POSTGRES_PASSWORD": 9, "apiKey": 123456, "pwd": 1.5},
      "want": {
        "password": "<REDACTED:password>",
        "db_password": "<REDACTED:db_password>",
        "POSTGRES_PASSWORD": "<REDACTED:POSTGRES_PASSWORD>",
        "apiKey": "<REDACTED:apiKey>",
        "pwd": "<REDACTED:pwd>"
      }
    },
    {
      "name": "digits in a string under a password key",
      "input": {"password": "1234", "password_expiry_days": "90", "token": "60", "ttl": "30m"},
      "want": {"password": "<REDACTED:password>", "password_expiry_days": "90", "token": "60", "ttl": "30m"}
    },
    {
      "name": "settings and counts stay",
      "input": {
        "max_tokens": 1000,
        "token_ttl": 60,
        "password_min_length": 12,
        "password_expiry_days": 90,
        "secret": 3,
        "token": 5,
        "secrets": 7,
        "credentials": 2,
        "replicas": 3,
        "port": 5432,
        "secretName": "tls"
      },
      "want": {
        "max_tokens": 1000,
        "token_ttl": 60,
        "password_min_length": 12,
        "password_expiry_days": 90,
        "secret": 3,
        "token": 5,
        "secrets": 7,
        "credentials": 2,
        "replicas": 3,
        "port": 5432,
        "secretName": "tls"
      }
    },
    {
      "name": "what holds no value stays",
      "input": {"password": true, "api_key": null, "db_password": "", "client_secret": false},
      "want": {"password": true, "api_key": null, "db_password": "", "client_secret": false}
    },
    {
      "name": "rows of a count table stay",
      "input": [{"name": "Secret", "value": 12}, {"name": "Secrets", "value": "12"}, {"name": "Token", "value": 7}, {"name": "Pods", "value": 40}],
      "want": [{"name": "Secret", "value": 12}, {"name": "Secrets", "value": "12"}, {"name": "Token", "value": 7}, {"name": "Pods", "value": 40}]
    },
    {
      "name": "a password in a string's sentence, the rest of it staying",
      "input": {"msg": "user=bob password=fake-pass-1 retries=3", "url": "https://example.test/?q=password&page=2"},
      "want": {"msg": "user=bob password=<REDACTED:password> retries=3", "url": "https://example.test/?q=password&page=2"}
    }
  ]
}
