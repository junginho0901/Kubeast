      "want": "{\"env\":[{\"name\":\"PGPASSWORD\",\"value\":\"<REDACTED:PGPASSWORD>\"},{\"name\":\"APIKEY\",\"value\":\"<REDACTED:APIKEY>\"},{\"name\":\"LOG_LEVEL\",\"value\":\"debug\"}]}\n"
    },
    {
      "name": "glued names in a YAML env entry",
      "input": "- name: PGPASSWORD\n  value: fake-pass-1\n- name: APIKEY\n  value: \"fake-key-1\"\n- name: LOG_LEVEL\n  value: debug\n",
      "want": "- name: PGPASSWORD\n  value: <REDACTED:PGPASSWORD>\n- name: APIKEY\n  value: \"<REDACTED:APIKEY>\"\n- name: LOG_LEVEL\n  value: debug\n"
