      "want": [{"name": "DB_PWD", "value": "<REDACTED:DB_PWD>"}, {"DB_PWD": "<REDACTED:DB_PWD>"}, {"PWD": "<REDACTED:PWD>"}, {"name": "PWD", "value": "<REDACTED:PWD>"}]
